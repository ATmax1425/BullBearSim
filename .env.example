# Postgres password used by the postgres and consumer services.
# Generate one, e.g.: openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# KRaft cluster ID: a base64 UUID (22 characters). Generate one with:
#   docker run --rm confluentinc/cp-kafka:7.5.0 kafka-storage random-uuid
# Keep it unchanged once Kafka has stored data in the kafka-data volume.
KAFKA_CLUSTER_ID=replace-with-generated-id
